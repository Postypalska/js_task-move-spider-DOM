"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
document.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    var isInsideWall = e.clientX >= wallRect.left && e.clientX <= wallRect.right && e.clientY >= wallRect.top && e.clientY <= wallRect.bottom;
