    var maxTop = wall.clientHeight - spider.offsetHeight;
    var spiderLeft = e.clientX - wallRect.left - wall.clientLeft - spider.offsetWidth / 2;
    var spiderTop = e.clientY - wallRect.top - wall.clientTop - spider.offsetHeight / 2;
    spiderLeft = Math.max(0, Math.min(spiderLeft, maxLeft));
